# For local demo. Change to a long random secret before real deployment.
SMARTSCHEDULE_API_KEY=local-demo-key
SMARTSCHEDULE_DB=./smartschedule.db
# Optional real email delivery settings (never commit real credentials):
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=your-account@example.com
